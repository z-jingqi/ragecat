; Rage Cat — standalone desktop arena survival
config_version=5
[application]
config/name="Rage Cat"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045,0.055,0.09,1)
[physics]
common/physics_ticks_per_second=60

[gui]
theme/custom_font="res://resources/fonts/ragecat-ui-subset.otf"

[internationalization]
locale/translations=PackedStringArray("res://resources/localization/en.po", "res://resources/localization/zh_CN.po")
locale/fallback="en"
