extends SceneTree
const Profile=preload("../components/slash_profile.gd")
const Arc=preload("../components/copper_arc.gd")
const Particles=preload("../components/hit_particles.gd")
const Slash=preload("../components/xingtian_slash.gd")
var failures:=0
var checks:=0

func check(value:bool,message:String)->void:
	checks+=1
	if not value: failures+=1; push_error(message)

func _initialize()->void:
	call_deferred("run")

func run()->void:
	var raw=Profile.new(); raw.radius=NAN; raw.thickness=200; raw.duration=0.12; raw.onset=0.09; raw.hold=0.08; raw.pixel_size=2.7; raw.intensity=INF; raw.blood_count=100; raw.edge_color=Color(NAN,2,-1,0)
	var safe=raw.sanitized()
	check(safe.radius==52.0 and is_nan(raw.radius),"Sanitize copies without mutating caller")
	check(safe.thickness<=safe.radius*0.5 and safe.onset+safe.hold<safe.duration,"Thickness/timing retain valid geometry")
	check(safe.pixel_size==3 and safe.intensity==1 and safe.blood_count==20,"Pixel size, nonfinite intensity and bounded counts")
	check(safe.edge_color.r>=0 and safe.edge_color.r<=1 and safe.edge_color.a==1,"Colors sanitized")
	var profile=Profile.new()
	for constructor in [Arc,Particles]:
		var node=constructor.new(); root.add_child(node)
		node.set_enabled(false); node.play(Vector2(3,4),profile); node.seek(0.06)
		check(not node.visible and node.position==Vector2(3,4),"Pre-play disable persists")
		node.set_enabled(true); check(node.visible,"Re-enable uses current time")
		var saved=node.elapsed; node.advance(-1); node.advance(NAN); node.seek(INF)
		check(node.elapsed==saved,"Invalid dt/seek is ignored")
		node.seek(node.lifetime()); check(not node.visible and not node.is_running(),"Exact end is empty")
		node.seek(0.06); check(node.visible,"Naturally ended effects can seek backwards")
		node.clear(); node.seek(0.06); node.advance(1); check(not node.visible and not node.started,"Clear cannot resurrect")
		node.play(Vector2.ZERO,profile); node.stop(); node.seek(0.06); check(not node.visible,"Stop cannot resurrect")
		node.play(Vector2(INF,0),profile); check(not node.started,"Nonfinite origin is rejected")
		node.play(Vector2.ZERO,Resource.new()); check(node.profile.radius==52.,"Wrong Resource safely falls back")
		node.free()
	var first=Arc.new(); var second=Arc.new(); root.add_child(first); root.add_child(second)
	first.play(Vector2.ZERO,profile); second.play(Vector2.ZERO,profile)
	first.seek(0.1); second.seek(0.02)
	check(first.surface.material!=second.surface.material and first.elapsed!=second.elapsed,"Independent materials and clocks")
	profile.radius=80; check(first.profile.radius==52.,"Playing settings are a snapshot")
	first.free(); second.free(); profile=Profile.new()
	for blood_mode in [false,true]:
		var particle=Particles.new(); particle.blood=blood_mode; root.add_child(particle)
		particle.play(Vector2.ZERO,profile); particle.seek(0.08); var sample=particle.samples()
		check(sample.size()>0 and sample.size()<=(9 if blood_mode else 6),"Sparse deterministic particles")
		particle.seek(0.2); particle.seek(0.08); check(particle.samples()==sample,"Seek is deterministic")
		particle.play(Vector2.ZERO,profile); particle.advance(0.04); particle.advance(0.04); check(particle.samples()==sample,"Analytic particles are timestep independent")
		var off=profile.duplicate(); off.set("blood_enabled" if blood_mode else "sparks_enabled",false)
		particle.play(Vector2.ZERO,off); particle.seek(0.08); check(particle.samples().is_empty(),"Config disable hides particles")
		off=profile.duplicate(); off.set("blood_count" if blood_mode else "spark_count",0)
		particle.play(Vector2.ZERO,off); particle.seek(0.08); check(particle.samples().is_empty(),"Zero density means zero particles")
		off=profile.duplicate(); off.intensity=0
		particle.play(Vector2.ZERO,off); particle.seek(0.08); check(particle.samples().is_empty(),"Zero intensity is fully empty")
		particle.free()
	var composite=Slash.new(); root.add_child(composite)
	composite.play(Vector2(10,20),profile); composite.advance(0.08)
	check(composite.arc.visible and not composite.blood.started and not composite.sparks.started,"Missed swing cannot spawn blood or sparks")
	composite.play_hit(Vector2(60,20),profile); composite.advance(0.05)
	check(composite.blood.visible and composite.sparks.visible and composite.blood.position==Vector2(60,20),"Explicit hit uses contact point")
	composite.set_layer_enabled("blood",false); check(not composite.blood.visible and composite.sparks.visible,"Blood toggle is independent")
	composite.play(Vector2.ZERO,profile); check(not composite.blood.started and not composite.sparks.started,"Repeated play clears old hit")
	composite.free()
	var scene=load("res://preview.tscn").instantiate(); root.add_child(scene); await process_frame; scene.set_process(false)
	scene.seek_all(0.12); check(scene.hit_shown and scene.composed.blood.visible,"Preview contact is visible")
	scene.toggles.blood.button_pressed=false; check(not scene.composed.blood.visible and not scene.blood_only.visible,"UI blood checkbox controls composition and solo")
	scene.replay(); scene.seek_all(0.12); check(not scene.composed.blood.visible,"Replay preserves toggles")
	scene.clear_all(); scene.timeline.value=0.1; check(not scene.composed.arc.visible,"Timeline cannot revive cleared effects")
	scene.sliders.radius.value=54; check(scene.cleared and not scene.composed.arc.visible,"Parameter edits cannot revive cleared effects")
	scene.set_speed(0.5); check(scene.speed_button.text=="0.50x slow","Speed caption reflects actual capture speed")
	scene.replay(); scene.timeline.value=0.12; check(scene.paused and is_equal_approx(scene.elapsed,0.1166666667),"Timeline scrubs and pauses")
	scene.apply_preset("heavy"); check(scene.profile.radius==68 and scene.holder.scale.x==2,"Heavy preset changes range and integer view scale")
	scene.sliders.radius.value=20; scene.sliders.thickness.value=28
	check(scene.profile.thickness==10 and scene.sliders.thickness.value==10,"Slider/readout reflects sanitized thickness")
	scene.seek_all(0.03); check(not scene.hit_shown and not scene.composed.blood.started,"Backward scrub before impact clears hit")
	scene.free()
	print("XINGTIAN_SLASH: %d checks, %d failures"%[checks,failures])
	quit(1 if failures else 0)
