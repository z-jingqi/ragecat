extends SceneTree
const Profile=preload("../components/slash_profile.gd")
const Slash=preload("../components/xingtian_slash.gd")
const Impact=preload("../components/hit_impact.gd")
const Particles=preload("../components/hit_particles.gd")
var checks:=0
var failures:=0
func check(ok:bool,description:String)->void:
	checks+=1
	if not ok: failures+=1; push_error(description)
func _initialize()->void: call_deferred("run")
func run()->void:
	var hit=Slash.new(); root.add_child(hit)
	check(hit.get("impact")!=null,"An explicit hit has an independent compact impact layer")
	var p=Profile.new()
	check(p.get("impact_duration")!=null,"Impact duration can be configured without changing slash duration")
	var unsafe=Profile.new(); unsafe.impact_radius=NAN; unsafe.impact_duration=99; unsafe.impact_core_duration=INF
	var safe=unsafe.sanitized()
	check(safe.impact_radius==12 and safe.impact_duration==0.24 and safe.impact_core_duration==0.04,"Impact bounds and nonfinite fallback")
	check(is_nan(unsafe.impact_radius),"Sanitization leaves caller untouched")
	var impact=Impact.new(); root.add_child(impact)
	impact.set_enabled(false); impact.play(Vector2(20,30),p); impact.seek(0.012)
	check(impact.samples().is_empty() and not impact.visible,"Disable before play persists")
	impact.set_enabled(true); var first=impact.samples()
	check(first.size()>40 and first.size()<250,"Compact first beat has a clear silhouette")
	impact.seek(0.025); check(impact.samples()!=first,"Second beat changes its silhouette")
	impact.seek(0.065); var fragments=impact.samples()
	check(fragments.size()>0 and fragments.size()<first.size(),"Fragments are sparse after the core")
	impact.seek(0.012); check(impact.samples()==first,"Seek returns exactly to previous geometry")
	impact.play(Vector2.ZERO,p); impact.advance(0.006); impact.advance(0.006)
	check(impact.samples()==first,"Analytic core is timestep independent")
	impact.seek(1.0/60.0); check(impact.samples()==first,"First 60fps contact advance preserves the bright first beat")
	impact.seek(1.0/30.0); check(not impact.samples().is_empty(),"A 30fps step cannot skip the entire core")
	impact.seek(p.impact_duration); check(impact.samples().is_empty() and not impact.is_running(),"Exact end is empty")
	impact.seek(0.065); check(impact.samples()==fragments,"Natural end remains seekable")
	impact.stop(); impact.seek(0.012); check(impact.samples().is_empty(),"Stop cannot resurrect")
	impact.play(Vector2(INF,0),p); check(not impact.started,"Invalid origin rejects play")
	impact.play(Vector2.ZERO,Resource.new()); check(impact.profile.impact_radius==12,"Wrong resource uses defaults")
	impact.seek(0.012); var saved=impact.elapsed; impact.advance(-1); impact.advance(NAN); impact.seek(INF)
	check(impact.elapsed==saved,"Invalid time is ignored")
	var muted=p.duplicate(); muted.impact_enabled=false; impact.play(Vector2.ZERO,muted); impact.seek(0.012)
	check(impact.samples().is_empty(),"Profile impact toggle clears all geometry")
	muted=p.duplicate(); muted.intensity=0; impact.play(Vector2.ZERO,muted); impact.seek(0.012)
	check(impact.samples().is_empty(),"Zero intensity produces nothing")
	muted=p.duplicate(); muted.impact_ring_enabled=false; muted.impact_fragments_enabled=false; impact.play(Vector2.ZERO,muted); impact.seek(0.065)
	check(impact.samples().is_empty(),"Fragments and broken pressure ring are optional")
	impact.free()
	hit.play(Vector2.ZERO,p); hit.advance(0.10)
	check(not hit.impact.started and not hit.blood.started,"Miss does not imply contact")
	hit.play_hit(Vector2(33,14),p); hit.advance(0.025)
	check(hit.impact.visible and hit.impact.position==Vector2(33,14),"Explicit contact locates impact")
	hit.set_layer_enabled("impact",false); check(not hit.impact.visible and hit.blood.visible,"Independent impact toggle")
	hit.play_hit(Vector2(50,30),p); check(hit.impact.position==Vector2(50,30) and hit.impact.elapsed==0,"New hit replaces old contact")
	hit.play(Vector2.ZERO,p); check(not hit.impact.started,"New slash clears old contact")
	hit.free()
	var blood=Particles.new(); blood.blood=true; root.add_child(blood); blood.play(Vector2.ZERO,p); blood.seek(0.035)
	check(blood.filaments().size()>0 and blood.filaments().size()<40,"Short sparse blood filaments")
	blood.seek(0.075); check(blood.filaments().is_empty(),"Filaments detach and end rapidly")
	for key in ["blood_enabled","blood_filaments_enabled"]:
		muted=p.duplicate(); muted.set(key,false); blood.play(Vector2.ZERO,muted); blood.seek(0.035)
		check(blood.filaments().is_empty(),"Blood/filament toggle: "+key)
	muted=p.duplicate(); muted.blood_count=0; blood.play(Vector2.ZERO,muted); blood.seek(0.035)
	check(blood.filaments().is_empty() and blood.samples().is_empty(),"Zero blood also means zero strands")
	blood.free()
	var scene=load("res://hit_preview.tscn").instantiate(); root.add_child(scene); await process_frame; scene.set_process(false)
	scene.seek_all(0.085); check(scene.composed.impact.visible and scene.impact_only.visible,"Preview exposes composed and isolated contact")
	scene.toggles.impact.button_pressed=false; check(not scene.composed.impact.visible and not scene.impact_only.visible,"UI contact toggle controls both views")
	scene.replay(); scene.seek_all(0.085); check(not scene.composed.impact.visible,"Replay retains impact toggle")
	scene.toggles.impact.button_pressed=true; scene.miss=true; scene.replay(); scene.seek_all(0.085)
	check(not scene.composed.impact.started and not scene.composed.blood.started and not scene.impact_only.started,"Miss mode keeps every contact layer empty")
	scene.miss=false; scene.replay(); scene.seek_all(0.085); scene.clear_all(); scene.timeline.value=0.1; scene.sliders.impact_radius.value=24
	check(scene.cleared and not scene.composed.impact.visible,"Clear and parameter editing cannot resurrect contact")
	scene.replay(); scene.seek_all(0.085); check(scene.composed.impact.profile.impact_radius==24 and scene.impact_only.scale.x==1,"Replay uses edited impact settings and bounded small-panel scale")
	scene.seek_all(0.02); check(not scene.composed.impact.started,"Scrubbing before hit clears contact")
	scene.free()
	print("XINGTIAN_HIT: %d checks, %d failures"%[checks,failures])
	quit(1 if failures else 0)
