extends SceneTree
const Profile=preload("res://components/lava_profile.gd")
const Solar=preload("res://components/solar_lava.gd")
const TYPES=[preload("res://components/lava_surface.gd"),preload("res://components/lava_bubbles.gd"),preload("res://components/short_flames.gd"),preload("res://components/impact_sparks.gd"),preload("res://components/rising_smoke.gd")]
var checked:=0
var failures:=0
func _initialize() -> void: call_deferred("run")
func check(condition:bool,message:String) -> void:
	checked+=1
	if not condition: failures+=1; push_error(message)
func run() -> void:
	var p=Profile.new()
	var saved=load("res://presets/default.tres").sanitized()
	var grown=load("res://presets/grown.tres").sanitized()
	check(saved.radius==54. and grown.radius==84.,"Presets load")
	check(saved.lava_orange==grown.lava_orange and saved.flame_height==grown.flame_height,"Preset brightness/height unchanged")
	check(is_equal_approx(p.total_time(),6.15),"Default visual timeline")
	check(p.heat_at(1.)==1. and p.heat_at(5.5)==0.,"Heat lifecycle")
	check(p.opacity_at(6.15)==0.,"Fade reaches zero")
	var dirty=Profile.new(); dirty.radius=NAN; dirty.flow_speed=INF; dirty.lava_opacity=-3.; dirty.bubble_count=1000; dirty.smoke_opacity=8.; dirty.pixel_size=1.6
	var clean=dirty.sanitized()
	check(clean.radius==54.,"NaN radius fallback")
	check(clean.flow_speed==0.22,"Infinite flow fallback")
	check(clean.lava_opacity==0.,"Opacity clamped")
	check(clean.bubble_count==24,"Bounded bubble density")
	check(clean.smoke_opacity==0.35,"Bounded smoke alpha")
	check(clean.pixel_size==2.,"Integer pixel lattice")
	check(is_nan(dirty.radius) and dirty.bubble_count==1000,"Source profile not mutated")
	for Type in TYPES:
		var fx=Type.new(); root.add_child(fx)
		fx.seek(1.); check(fx.done,"Seek before play does not start")
		fx.set_enabled(false); fx.play(Vector2(4,5),p)
		check(not fx.visible and not fx.done,"Preplay disabled persisted")
		fx.set_enabled(true); check(fx.visible,"Enable running layer")
		fx.seek(1.25); check(fx.age==1.25,"Absolute seek")
		var point:Vector2=fx.site(5,4)
		fx.seek(2.); fx.seek(1.25); check(fx.site(5,4)==point,"Deterministic site seek")
		fx.advance(-1.); fx.advance(NAN); fx.seek(INF); check(fx.age==1.25,"Invalid time ignored")
		fx.advance(0.25); check(fx.age==1.5,"Caller advance")
		fx.seek(p.total_time()+8.); check(fx.done and not fx.visible,"Expiry hides")
		fx.seek(0.2); check(not fx.done and fx.visible,"Rewind after expiry")
		fx.stop(); fx.seek(1.); check(fx.done and not fx.visible,"Stop blocks seek")
		fx.play(Vector2.ZERO,Resource.new()); check(not fx.done,"Wrong resource safely defaults")
		fx.play(Vector2(NAN,0),p); check(fx.done,"Invalid origin stops")
		fx.play(Vector2.ZERO,p); check(fx.profile!=p,"Instance owns sanitized copy")
		if fx.has_method("count"):
			var normal:int=fx.count(); var large=p.duplicate(); large.radius=84.; fx.play(Vector2.ZERO,large)
			check(fx.count()>=normal,"Growth increases detail")
			check(fx.profile.lava_orange==p.lava_orange and fx.profile.flame_height==p.flame_height and fx.profile.smoke_opacity==p.smoke_opacity,"Growth brightness/height unchanged")
		for grain in range(1,5):
			var grid_profile=p.duplicate(); grid_profile.pixel_size=grain; fx.play(Vector2.ZERO,grid_profile)
			var seen:Dictionary={}
			for point_on_grid in fx.raster_grid(Vector2(-6,-5),Vector2(6,5)):
				var snapped:Vector2=point_on_grid.snapped(Vector2.ONE*grain)
				check(not seen.has(snapped),"No repeated snapped alpha samples")
				seen[snapped]=true
		fx.free()
	var a=Solar.new(); root.add_child(a)
	a.set_layer_enabled("flames",false); a.set_layer_enabled("invalid",true); a.play(Vector2.ZERO,p)
	check(a.layers.size()==5,"Five independent components")
	check(not a.layers.flames.visible,"Composer preplay toggle")
	a.seek(1.); a.play(Vector2.ZERO,p); check(not a.layers.flames.visible,"Composer replay keeps toggle")
	a.set_layer_enabled("flames",true); check(a.layers.flames.visible,"Composer enable")
	var second=Solar.new(); root.add_child(second); second.play(Vector2.ZERO,p); a.seek(3.)
	check(second.age==0.,"Instance clocks independent")
	for layer in a.layers.values(): check(layer.age==3.,"Composition synchronizes clock")
	a.clear(); a.seek(1.); check(a.done,"Composer clear persists")
	a.play(Vector2.ZERO,Resource.new()); check(not a.done,"Composer wrong-resource fallback")
	a.seek(p.total_time()); check(a.done,"Composer expiry")
	for layer in a.layers.values(): check(not layer.visible,"No expired residue")
	a.free(); second.free()
	var demo=load("res://preview.gd").new(); root.add_child(demo); demo.set_process(false)
	check(demo.solos.size()==5,"Five independent previews")
	demo.toggles.bubbles.button_pressed=false; demo.set_radius(84.)
	check(not demo.composed.layers.bubbles.enabled,"Toggle survives parameter/replay")
	check(demo.profile.radius==84.,"Grown visual radius")
	demo.sliders.bubble_count.value=0
	check(demo.composed.layers.bubbles.count()==0,"Zero density disables particles")
	demo.clear_all(); check(demo.composed.done,"Clear preview")
	demo.replay(); check(not demo.composed.done,"Repeated replay after clear")
	demo.timeline.value=2.; check(demo.paused and is_equal_approx(demo.composed.age,2.),"Timeline seek pauses")
	demo.free()
	print("SOLAR_LAVA_TESTS ",checked," checks; ",failures," failures")
	quit(0 if failures==0 else 1)
