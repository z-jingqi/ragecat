extends SceneTree
const Burn := preload("ground_burn.gd")
var checks := 0
var failed := 0
func _initialize() -> void: call_deferred("run")
func check(value: bool, label: String) -> void:
	checks += 1
	if not value:
		failed += 1
		push_error(label)
func run() -> void:
	var parent := Node2D.new()
	parent.position = Vector2(123, 47)
	parent.scale = Vector2(2, 2)
	root.add_child(parent)
	var first := Burn.new()
	parent.add_child(first)
	var options := {"seed": 9, "flame_count": 18, "pixel_size": 2.0}
	first.play(Vector2(32.25, 19.5), 36.5, 4.0, options)
	check(first.position == Vector2(32.25, 19.5), "origin is not rounded or changed")
	check(first.global_position == parent.to_global(Vector2(32.25, 19.5)), "local origin follows parent transform")
	check(first.radius == 36.5 and first.duration == 4.0, "game geometry and lifetime are preserved")
	check(first.get_child_count() == 2, "exactly two fixed surfaces")
	check(not first.is_processing() and not first.is_physics_processing(), "no autonomous clock")
	check(first.outline.z_index > first.body.z_index, "all sibling outlines can draw above every fill")
	check(first.outline.material != first.body.material, "passes own their uniforms")
	check(first.body.mouse_filter == Control.MOUSE_FILTER_IGNORE, "does not capture game input")
	options.flame_count = 0
	check(first.settings.flame_count == 18, "play snapshots caller options")
	first.seek(1.25)
	check(first.age == 1.25 and first.visible, "absolute external age controls visual")
	var parameter = first.body.material.get_shader_parameter("age")
	await process_frame
	await process_frame
	check(first.age == 1.25 and first.body.material.get_shader_parameter("age") == parameter, "pausing caller freezes phase without extra flag")
	first.seek(NAN); first.advance(INF); first.advance(-10)
	check(first.age == 1.25, "invalid and negative deltas cannot corrupt clock")
	first.seek(4.0)
	check(first.done and not first.visible, "exact expiry removes all surfaces")
	first.seek(0.5)
	check(not first.done and first.visible, "absolute clock can scrub an expired preview")
	first.advance(100.0)
	check(first.age == 4.0 and first.done, "long frame expires once with bounded state")
	first.stop(); first.seek(0.5)
	check(first.done and not first.visible, "explicit clear cannot be revived by stray seek")
	first.play(Vector2.ZERO, 36, 4, {"flame_count": 100000, "pixel_size": NAN, "intensity": -100, "seed": INF, "core_color": Color(INF, 0, 0)})
	check(first.settings.flame_count == Burn.MAX_FLAMES, "flame count has hard upper bound")
	check(first.settings.pixel_size == 2.0 and first.settings.intensity == 0.0, "invalid visual options sanitize")
	check(first.settings.core_color == Color("ffe5a0"), "nonfinite palette sanitizes")
	check(first.settings.seed == 37, "nonfinite seed sanitizes")
	for i in range(100): first.play(Vector2.ZERO, 36, 4)
	check(first.get_child_count() == 2, "replay never accumulates nodes")
	var second := Burn.new()
	parent.add_child(second)
	second.play(Vector2(18, 0), 52, 7, {"seed": 103})
	first.seek(1.0); second.seek(2.0)
	check(first.age == 1.0 and second.age == 2.0, "overlapping zones have independent ages")
	check(first.body.material != second.body.material, "overlapping zones have independent materials")
	check(first.radius == 36.0 and second.radius == 52.0, "overlapping zones retain separate boundaries")
	first.clear()
	check(second.visible and not second.done, "removing one zone never clears its neighbor")
	first.play(Vector2(NAN, 0), 36, 4)
	check(first.done and not first.visible, "nonfinite origins are rejected")
	first.play(Vector2.ZERO, 0, 4)
	check(first.done, "invalid radius is not invented")
	first.play(Vector2.ZERO, 36, INF)
	check(first.done, "invalid lifetime is not invented")
	for hz in [30, 60, 144]:
		first.play(Vector2.ZERO, 36, 4)
		for step in range(hz * 2): first.advance(1.0 / hz)
		check(is_equal_approx(first.age, 2.0), "external clock agrees at %d Hz" % hz)
	parent.free()
	print("GROUND BURN: %d checks, %d failed" % [checks, failed])
	quit(1 if failed else 0)
