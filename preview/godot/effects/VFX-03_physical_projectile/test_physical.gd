extends SceneTree
const History=preload("res://effects/VFX-03_physical_projectile/path_history.gd")
const Demo=preload("res://effects/VFX-03_physical_projectile/physical_projectile.tscn")
var checks:=0
var failures:=0
func check(ok:bool,message:String) -> void:
	checks+=1
	if not ok: failures+=1;push_error(message)
func _init() -> void: call_deferred("run")
func run() -> void:
	var h:=History.new()
	h.reset(Vector2.ZERO,Vector2.RIGHT*180)
	check(h.rear()==Vector2(-20,0) and h.emitting,"arrow rear anchor is physical body end")
	for i in range(60):h.tick(1.0/120.0,Vector2((i+1)*1.5,0),Vector2.RIGHT*180)
	check(h.trail_length>25.9 and h.trail_length<26.1,"speed response uses velocity")
	var r:=h.render_points()
	check(r.size()>3 and r[0].x==-20 and r[-1].x<r[0].x,"straight axial path stays behind body")
	check(h.points.size()==h.times.size() and h.points.size()<=History.CAP,"paired bounded buffers")
	var old_clock:=h.clock;var old_position:=h.world_position;var old_count:=h.points.size();var old_length:=h.trail_length
	h.paused=true;h.tick(1,Vector2(900,400),Vector2.ZERO)
	check(h.clock==old_clock and h.world_position==old_position and h.points.size()==old_count and h.trail_length==old_length,"pause freezes all state")
	h.reset(Vector2(1.2,3.4),Vector2.RIGHT*100)
	check(not h.paused and h.age==0 and h.clock==0 and h.points.size()==1,"reset clears clocks/history/pause")
	h.tick(0.01,Vector2(2.2,3.4),Vector2.RIGHT*100)
	check(absf(h.world_position.x-2.2)<0.00001,"simulation remains unquantized")
	h.tick(0.01,Vector2(400,3.4),Vector2.RIGHT*100)
	check(h.teleport_count==1 and h.points.size()==1 and h.render_points().size()==1,"teleport cannot bridge")
	h.configure({"body_kind":1})
	check(h.points.is_empty() and h.rear()==h.world_position-Vector2(18,0),"switching arrow to knife resets attachment history")
	h.reset(Vector2.ZERO,Vector2.RIGHT*180)
	for i in range(30):h.tick(1.0/120,Vector2((i+1)*1.5,0),Vector2.RIGHT*180)
	h.stop();old_position=h.world_position
	h.tick(0.04,Vector2(999,999),Vector2.ZERO)
	check(h.active and not h.emitting and h.world_position==old_position,"stop hides body and leaves stationary history fading")
	check(h.render_points()[0].w<1.0,"stop reduces lifetime weight")
	h.tick(0.2,Vector2.ZERO,Vector2.ZERO)
	check(not h.active and h.points.is_empty() and h.times.is_empty(),"stop expires within history duration")
	h.reset(Vector2.ZERO,Vector2.RIGHT);h.stop(true)
	check(not h.active and h.points.is_empty(),"immediate clear")
	h.lifetime=0.1;h.reset(Vector2.ZERO,Vector2.RIGHT*100)
	h.tick(0.09,Vector2(9,0),Vector2.RIGHT*100)
	check(h.emitting,"body alive before lifetime")
	h.tick(0.02,Vector2(11,0),Vector2.RIGHT*100)
	check(not h.emitting,"body lifetime expires")
	h.tick(0.3,Vector2.ZERO,Vector2.ZERO)
	check(not h.active,"lifetime plus history fully clears")
	h.reset(Vector2.ZERO,Vector2.RIGHT*100);h.lifetime=0.1
	h.tick(0.095,Vector2(9.5,0),Vector2.RIGHT*100);h.tick(0.01,Vector2(140,0),Vector2.RIGHT*100)
	check(h.teleport_count==1 and h.points.size()==1,"teleport at lifetime boundary still breaks history")
	h.configure({"trail_width":-10,"length_min":999,"length_max":-1,"history_seconds":-5,"taper":99,"speed_response":0,"body_scale":99})
	check(h.trail_width==0.5 and h.length_min==40 and h.length_max==40 and h.history_seconds==0.02 and h.taper==3 and h.speed_response==0.01 and h.body_scale==2,"extremes clamped")
	h.configure({"trail_width":NAN,"taper":INF})
	check(is_finite(h.trail_width) and is_finite(h.taper),"nonfinite config ignored")
	h.configure({"length_min":8,"length_max":64,"history_seconds":0.6,"lifetime":10})
	h.reset(Vector2.ZERO,Vector2.RIGHT*120)
	for i in range(2200):
		h.tick(1.0/240,Vector2((i+1)*0.5,0),Vector2.RIGHT*120)
		check(h.points.size()<=History.CAP and h.points.size()==h.times.size(),"bounded matching buffers")
	var results:=[]
	for fps in [30,60,144]:
		var b:=History.new();b.reset(Vector2.ZERO,Vector2.RIGHT*180)
		for i in range(fps):b.tick(1.0/fps,Vector2(180.0*(i+1)/fps,0),Vector2.RIGHT*180)
		results.append([b.world_position.x,b.trail_length,b.age])
	for result in results:check(absf(result[0]-180)<0.0001 and absf(result[1]-results[0][1])<0.0001 and absf(result[2]-1)<0.0001,"30/60/144 fps consistency")
	for fps in [30,60,144]:
		var boundary:=History.new();boundary.reset(Vector2.ZERO,Vector2.RIGHT*180)
		for i in range(ceil(1.61*fps)):boundary.tick(1.0/fps,Vector2(180.0*(i+1)/fps,0),Vector2.RIGHT*180)
		check(absf(boundary.world_position.x-288.0)<0.001 and not boundary.emitting,"lifetime samples exact endpoint across FPS")
	h.reset(Vector2.ZERO,Vector2.RIGHT*120);h.tick(0.1,Vector2(12,0),Vector2.RIGHT*120);old_length=h.trail_length
	h.tick(0.1,Vector2(12,0),Vector2.ZERO)
	check(h.trail_length<old_length*0.1,"stationary path retracts")
	old_clock=h.clock;h.tick(NAN,Vector2.ZERO,Vector2.ZERO);h.tick(0.1,Vector2(NAN,0),Vector2.ZERO)
	check(h.clock==old_clock,"invalid pose/time rejected")
	var d=Demo.instantiate();root.add_child(d);d.set_process(false);await process_frame
	d.simulate(0.1);d.toggle_pause();old_clock=d.history.clock;d._process(0.2)
	check(d.history.clock==old_clock,"UI pause")
	d.step_frame();check(d.paused and absf(d.history.clock-old_clock-1.0/60)<0.00001,"UI exact frame step")
	d.apply_preset(1);d.restart();check(d.history.body_kind==1 and d.history.trail_width==2.0,"knife preset")
	d.reset_all();check(d.history.body_kind==0 and not d.paused and d.speed==180 and d.show_trail,"UI full reset")
	d.sliders.trail_width.value=4.2;check(absf(d.history.trail_width-4.2)<0.0001,"independent trail width slider")
	d.teleport();check(d.history.teleport_count==1,"UI teleport")
	d.turning=true;var heading_before:float=d.heading;d.simulate(0.1)
	check(absf(d.heading-heading_before)<=0.120001,"preview turning angular velocity bounded")
	d.stopped=true;d.history.stop();for i in range(100):d.simulate(1.0/60)
	check(not d.history.active,"Stop is not auto-restarted by loop")
	d.restart();check(d.history.emitting and not d.stopped,"Replay restarts stopped state")
	d.background=2;d.set_background();check(d.labels.speed.get_theme_color("font_color")==Color("273840"),"light background label contrast")
	d.queue_free()
	print("Physical projectile tests: %d checks; %d failures"%[checks,failures]);quit(1 if failures else 0)
