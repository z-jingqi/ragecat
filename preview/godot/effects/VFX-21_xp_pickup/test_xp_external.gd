extends SceneTree
const Effect = preload("res://effects/VFX-21_xp_pickup/xp_external.gd")
func _initialize() -> void:
	var fx = Effect.new()
	root.add_child(fx)
	var host := Node2D.new()
	root.add_child(host)
	host.position = Vector2(17.25, 22.75)
	var points := [Vector2(1.125, 2.875), Vector2(2.25, 3.75), Vector2(3.5, 4.5)]
	for point in points:
		fx.sample_position(point)
	for i in range(points.size()):
		assert(fx.samples[i].position == points[i], "Supplied positions must not be moved or quantized")
	var count: int = fx.samples.size()
	fx.sample_position(points.back())
	assert(fx.samples.size() == count)
	fx.tick(900.0)
	assert(fx.last_position == points.back() and fx.has_sample and not fx.collected)
	assert(is_instance_valid(host) and host.position == Vector2(17.25, 22.75))
	assert(not fx.is_queued_for_deletion() and not fx.is_visually_active() and not fx.is_finished())
	assert(not fx.has_method("_process") and not fx.has_method("_physics_process"))
	fx.clear()
	for i in range(200):
		fx.sample_position(Vector2(i * 0.1, 0))
	assert(fx.samples.size() <= Effect.MAX_SAMPLES)
	fx.sample_position(Vector2(1000, 1000))
	assert(fx.samples.size() == 1)
	fx.set_paused(true)
	fx.tick(2.0)
	fx.sample_position(Vector2(1001, 1001))
	assert(fx.last_position == Vector2(1000, 1000) and fx.samples[0].age == 0.0)
	assert(not fx.collect(Vector2.ZERO))
	fx.set_paused(false)
	assert(fx.collect(Vector2(3.125, 7.875)))
	assert(not fx.collect(Vector2(99, 99)))
	assert(fx.arrival_position == Vector2(3.125, 7.875) and fx.samples.is_empty())
	fx.sample_position(Vector2.ZERO)
	assert(fx.last_position == Vector2(1000, 1000))
	fx.set_paused(true)
	fx.tick(2.0)
	assert(fx.arrival_age == 0.0)
	fx.set_paused(false)
	fx.tick(Effect.ARRIVAL_SECONDS)
	assert(not fx.is_visually_active() and fx.collected and not fx.collect(Vector2.ZERO))
	assert(fx.is_finished())
	fx.clear()
	assert(fx.is_finished())
	fx.sample_position(Vector2(NAN, 0))
	fx.tick(INF)
	assert(not fx.has_sample and not fx.collected and not fx.paused)
	assert(not fx.collect(Vector2(INF, 0)))
	fx.free()
	host.free()
	print("XP_EXTERNAL PASS: exact positions, no authority, bounded history, pause, collect once, clear")
	quit()
