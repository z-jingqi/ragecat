// GENERATED by effects/pixel/VFX-02_weapon_trail/build_shaders.py
shader_type canvas_item;
render_mode unshaded;
uniform vec4 trail_points[64];
uniform float trail_life[64];
uniform int trail_count = 0;
uniform float width_fraction = 0.68;
uniform float taper_power = 1.35;
uniform float opacity = 1.0;
uniform bool stepped_fade = false;
uniform float display_scale = 1.0;
uniform vec2 camera_pixels = vec2(0.0);
uniform vec4 core_color : source_color = vec4(1.0,0.9568627,0.8078431,1.0);
uniform vec4 body_color : source_color = vec4(0.9294118,0.7333333,0.3803922,1.0);
uniform vec4 edge_color : source_color = vec4(0.6745098,0.4352941,0.2078431,1.0);
varying vec2 world_pixels;
void vertex() {
    world_pixels = vec2(VERTEX.x, -VERTEX.y) / display_scale + camera_pixels;
}
// Canonical engine-independent VFX-02 math. Coordinates: world-aligned logical pixels.
// No textures, screen-space AA, derivatives, random values or engine functions.
float trail_cross(vec2 a, vec2 b) { return a.x * b.y - a.y * b.x; }

// Barycentric interpolation is orientation-independent (both clockwise and reverse work).
// Returns (remaining lifetime, across blade: 0 tip -> 1 inner edge), or (-1, -1).
vec2 trail_triangle(vec2 p, vec2 a, vec2 b, vec2 c,
                      vec2 va, vec2 vb, vec2 vc) {
    float area = trail_cross(b - a, c - a);
    if (abs(area) < 0.00001) return vec2(-1.0, -1.0);
    float wb = trail_cross(p - a, c - a) / area;
    float wc = trail_cross(b - a, p - a) / area;
    float wa = 1.0 - wb - wc;
    if (min(wa, min(wb, wc)) < -0.00001) return vec2(-1.0, -1.0);
    return va * wa + vb * wb + vc * wc;
}

// Sweep between two REAL sampled weapon poses, never a generated trajectory.
// base_tip: xy = base, zw = tip. Width is a fraction of the sampled blade length.
vec2 trail_segment(vec2 p, vec4 older, vec4 newer,
                     float old_life, float new_life, float width_value, float taper_value) {
    vec2 a = older.zw;
    vec2 b = a + (older.xy - a) * width_value * pow(max(old_life, 0.0), taper_value);
    vec2 d = newer.zw;
    vec2 c = d + (newer.xy - d) * width_value * pow(max(new_life, 0.0), taper_value);
    vec2 v = trail_triangle(p, a, b, c, vec2(old_life, 0.0),
                              vec2(old_life, 1.0), vec2(new_life, 1.0));
    if (v.x >= 0.0) return v;
    return trail_triangle(p, a, c, d, vec2(old_life, 0.0),
                          vec2(new_life, 1.0), vec2(new_life, 0.0));
}

// Hard-edged palette selection. Old tail loses its bright edge before it disappears.
float trail_band(vec2 coverage) {
    if (coverage.x <= 0.0) return 0.0;
    if (coverage.y < 0.20 && coverage.x > 0.50) return 3.0;
    if (coverage.y < 0.72 && coverage.x > 0.20) return 2.0;
    return 1.0;
}

void fragment() {
    vec2 p = floor(world_pixels) + vec2(0.5);
    vec2 best = vec2(-1.0);
    for (int i = 1; i < 64; i++) {
        if (i >= trail_count) { break; }
        vec2 hit = trail_segment(p, trail_points[i-1], trail_points[i],
            trail_life[i-1], trail_life[i], width_fraction, taper_power);
        if (hit.x > best.x) { best = hit; }
    }
    float band = trail_band(best);
    vec4 col = band > 2.5 ? core_color : (band > 1.5 ? body_color : edge_color);
    float fade = stepped_fade ? ceil(clamp(best.x, 0.0, 1.0) * 4.0) / 4.0 : 1.0;
    COLOR = vec4(col.rgb, band > 0.5 ? col.a * opacity * fade : 0.0);
}
