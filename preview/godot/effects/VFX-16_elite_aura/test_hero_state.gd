extends SceneTree
const Effect := preload("hero_state.gd")
const Aura := preload("aura.gd")
var checks := 0
func check(value: bool, message: String) -> void:
	checks += 1
	assert(value,message)
func _initialize() -> void:
	var fx := Effect.new();root.add_child(fx)
	fx.position = Vector2(20,30)
	check(fx.get_child_count() == 2 and not fx.aura.automatic and not fx.return_effect.automatic,"two fixed external-clock components")
	fx.set_war(true,Vector2(80,100));fx.tick(.2)
	check(fx.war_active and fx.aura.anchor == Vector2(60,70),"world anchor to local")
	fx.tick(10000)
	check(fx.aura.active and fx.aura.strength() == 1.0,"caller state cannot expire by visual timer")
	fx.set_war(true,Vector2(100,100),true)
	check(fx.aura.anchor == Vector2(80,70) and fx.aura.config.body == "cb8469","actual follow and urgency")
	var before: float = fx.aura.age
	fx.set_paused(true);fx.tick(5);fx.set_war(true,Vector2.ZERO)
	check(fx.aura.age == before and fx.aura.anchor == Vector2(80,70),"pause freezes position and time")
	check(not fx.revive(Vector2.ZERO,1),"paused event ignored")
	fx.set_paused(false)
	check(fx.revive(Vector2(100,100),1),"real event starts return")
	check(not fx.war_active and not fx.aura.active and fx.return_effect.active,"war cannot overlap return")
	check(not fx.revive(Vector2.ZERO,1),"event is idempotent")
	fx.set_war(false,Vector2.ZERO)
	check(fx.return_effect.active,"ordinary no-war sampling does not cancel return")
	fx.tick(.6)
	check(not fx.return_effect.active and not fx.revive(Vector2.ZERO,1),"finite return cannot replay same event")
	check(fx.revive(Vector2.ZERO,2),"new actual event allowed")
	fx.set_war(true,Vector2.ZERO)
	check(not fx.return_effect.active and fx.aura.active,"new war replaces return")
	fx.set_war(false,Vector2.ZERO)
	check(not fx.aura.active,"state ends immediately")
	for fps in [30,60,144]:
		fx.clear();fx.revive(Vector2.ZERO,0)
		for i in range(fps):fx.tick(1.0/fps)
		check(not fx.return_effect.active,"fps-consistent finite return")
	for i in range(1000):
		fx.set_war(true,Vector2.ZERO);fx.tick(.2);fx.revive(Vector2.ZERO,i);fx.clear()
		check(fx.get_child_count() == 2 and not fx.aura.active and not fx.return_effect.active,"bounded reuse and clear")
	fx.set_war(true,Vector2.ZERO);fx.tick(INF);fx.tick(-1)
	check(fx.aura.age == 0,"invalid time ignored")
	fx.set_war(true,Vector2.INF)
	check(not fx.war_active and not fx.aura.active,"invalid anchor clears")
	var ordinary := Aura.new();ordinary.automatic = false;root.add_child(ordinary)
	ordinary.play(Vector2.ZERO);ordinary.tick(10)
	check(not ordinary.active,"existing canonical aura still naturally ends")
	ordinary.free();fx.free()
	print("HERO STATE PASS: ",checks," checks")
	quit()
