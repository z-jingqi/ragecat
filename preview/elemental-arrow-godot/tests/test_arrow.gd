extends SceneTree
const FX=preload("../components/elemental_arrow.gd")
const Profile=preload("../components/arrow_profile.gd")
var count:int=0
func check(value:bool,label:String)->void:
	if not value: push_error(label); quit(1)
	assert(value,label); count+=1
func _initialize()->void:
	var fx=FX.new(); root.add_child(fx); var cfg=Profile.new()
	fx.play(Vector2(20,30),Vector2(80,0),cfg)
	check(fx.running and fx.pose.axis==Vector2.RIGHT,"plain arrow starts right")
	fx.advance(.1,Vector2(12,30),Vector2(-80,0))
	check(fx.pose.axis==Vector2.LEFT,"negative velocity orients left")
	fx.advance(.1,Vector2(12,24),Vector2(0,-60))
	check(fx.pose.axis==Vector2.UP,"vertical velocity orients up")
	fx.advance(.1,Vector2(12,24),Vector2.ZERO)
	check(fx.pose.axis==Vector2.UP,"stationary holds last orientation")
	check(fx.history.size()==4,"bounded trajectory records live poses")
	fx.seek(.5,func(t): return {"tip":Vector2(t*100,t*t*30),"velocity":Vector2(100,t*60)})
	check(fx.pose.tip.is_equal_approx(Vector2(50,7.5)),"seek follows analytic trajectory")
	check(fx.pose.axis.is_equal_approx(Vector2(100,30).normalized()),"curve follows tangent")
	var past=fx.pose_at(.3)
	check(past.tip.distance_to(Vector2(30,2.7))<.02,"wake retains world-space curved history")
	cfg.length=60; check(fx.profile.length==34,"deep config copy isolates caller")
	fx.profile.fire.size=2; check(cfg.fire.size==1,"deep attachment copy isolates caller")
	fx.set_layer_enabled("body",false); check(not fx.layer_enabled.body,"body independent toggle")
	fx.clear(); fx.seek(.8,func(t): return {"tip":Vector2(t,0),"velocity":Vector2.RIGHT})
	check(not fx.running and fx.history.is_empty(),"clear cannot resurrect by seek")
	fx.advance(.1,Vector2.ZERO,Vector2.ONE); check(not fx.running,"clear cannot resurrect by advance")
	fx.play(Vector2.ZERO,Vector2.RIGHT); check(fx.running,"explicit replay restores")
	fx.advance(NAN,Vector2.ZERO,Vector2.ZERO); check(fx.age==0,"reject nonfinite delta")
	cfg.length=NAN; cfg.fire.size=INF; cfg.fire.intensity=-10; fx.configure(cfg)
	check(fx.profile.length==34 and fx.profile.fire.size==1 and fx.profile.fire.intensity==0,"sanitizes limits and nonfinite inputs")
	for i in 1000: fx.advance(.001,Vector2(i*.1,0),Vector2.RIGHT*100)
	check(fx.history.size()<=160,"bounded history at high tick rates")
	fx.advance(.01,Vector2(900,900),Vector2.RIGHT); check(fx.history.size()==1,"teleport resets unrelated wake")
	print("PASS arrow state / geometry / ownership / lifecycle: ",count," assertions")
	quit()
