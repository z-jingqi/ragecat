msgid "TEMPLATE_DARK_BOW"
msgstr "Unlocks Shadow Arrow and Gravity. One arrow with unlimited direct hits; Fan, Split, and Volley convert into Gravity bonuses."

msgid "TEMPLATE_BURST"
msgstr "Bow exclusive: {values} additional volleys, {spacing}s apart; each arrow retains {damage_multiplier_percent}% damage (including side arrows and fragments)."

msgid "TEMPLATE_VITALITY"
msgstr "+{values} maximum health at each rank."

msgid "TEMPLATE_SHIELD"
msgstr "Gain {values} whole-hit shield capacity at each rank. Each current shield adds {shield_crit_percent}% crit chance, capped at {shield_crit_cap_percent}% from shields. Total crit chance is capped at {total_crit_cap_percent}%."

msgid "TEMPLATE_ICE_ENCHANT"
msgstr "+{values} elemental damage only. Switch type freely; shared ranks are preserved."

msgid "TEMPLATE_SPREAD_ARROW"
msgstr "Bow exclusive: fire {values} additional side arrows at {side_damage_percent}% damage. This is firing-time scatter, not impact splitting."

msgid "TEMPLATE_PICKUP_RADIUS"
msgstr "+{values} pickup radius at each rank."

msgid "TEMPLATE_DAMAGE"
msgstr "+{values}% total damage (base + element) at each rank."

msgid "TEMPLATE_MOVE_SPEED"
msgstr "+{percent_values}% movement speed at each rank."

msgid "TEMPLATE_DAMAGE_FLAT"
msgstr "+{values} base weapon damage, before percentage bonuses."

msgid "TEMPLATE_KNOCKBACK"
msgstr "+{percent_values}% arrow knockback. Bosses remain immune."

msgid "TEMPLATE_LIGHTNING_BOW"
msgstr "Every direct impact, including piercing and split fragment hits, launches a separate chain. Chain damage never chains again."

msgid "TEMPLATE_LIGHTNING_ENCHANT"
msgstr "+{values} elemental damage only. Switch type freely; shared ranks are preserved."

msgid "TEMPLATE_PIERCE"
msgstr "First hit is full damage. Later hits retain {retention_percent_values}% damage at each rank, without repeated decay."

msgid "TEMPLATE_SPLIT"
msgstr "First impact creates {fragment_count} fragments at {percent_values}% pre-critical damage. Fragments share remaining range and inherit elemental damage, each rolls its own critical hit, but cannot pierce or split again. Fire fragments explode and lightning fragments chain using their own scaled elemental damage; ice fragments apply frost or shatter, while Shadow Arrow creates no fragments."

msgid "TEMPLATE_ICE_BOW"
msgstr "All direct arrows, including fragments, can apply frost or shatter. Bosses gain a Frost Mark instead of freezing."

msgid "TEMPLATE_FIRE_ENCHANT"
msgstr "+{values} elemental damage only. Switch type freely; shared ranks are preserved."

msgid "TEMPLATE_FIRE_BOW"
msgstr "Main arrows and split fragments explode on their first valid hit, then retire. Pierce upgrades are inactive; rank is kept."

msgid "TEMPLATE_LONG_DRAW"
msgstr "Bow exclusive: +{percent_values}% total arrow range and projectile speed."

msgid "TEMPLATE_REGEN"
msgstr "Recover health every second."

msgid "TEMPLATE_ATTACK_SPEED"
msgstr "+{percent_values}% attack speed at each rank."

msgid "TEMPLATE_CRIT_DAMAGE"
msgstr "+{values} critical multiplier at each rank."

msgid "TEMPLATE_CRIT_CHANCE"
msgstr "+{percent_values}% critical chance at each rank."

msgid "TEMPLATE_DARK_ENCHANT"
msgstr "+{values} elemental damage only. Switch type freely; shared ranks are preserved."


