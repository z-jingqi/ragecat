msgid "DESC_FIRE"
msgstr "Blazing Arrow / Burn\nMain + fragments: first-hit blast, then retire\n%s%% of each arrow E; Radius %s\nBlast excludes primary and cannot crit; Pierce inactive\nDirect/blast: %s%% burn; %s%% arrow E/s for %ss\nRefresh only; keeps DPS and tick clock"

msgid "DESC_LIGHTNING"
msgstr "Lightning Arrow / Shock\nEach direct hit, including fragments: chain to %d additional targets\n%s%% elemental damage; %s range per hop\nDirect/chain: %s%% shock for %ss\nNext elemental hits +%s%%; refresh only, no stacking\nChain uses each arrow’s elemental damage once; no crit or repeat target per chain"

msgid "DESC_ICE"
msgstr "Frost Arrow / Frostbite\nAll direct arrows: chill %s%% / %ss; %d frost = freeze %ss\nNext direct hit: %sx (base + element); ends freeze, no new frost\nFrost window %ss; thaw immunity %ss\nBoss: %s%% slow; %d frost = %ss mark, next hit %sx\nFrozen stops movement only; Bosses never freeze"

msgid "DESC_GRAVITY_MISSING"
msgstr "Gravity configuration missing"

msgid "DESC_DARK"
msgstr "Shadow Arrow / Gravity\nUnlimited targets, each hit once; full damage; Pierce inactive\nOne gravity arrow: %s px/s\nPull radius %s / damage radius %s\n%s%% E per second; after expiry: gap %ss (min %ss)"

msgid "DESC_PIERCE_DARK"
msgstr "Inactive: Gravity has unlimited direct hits\n100% retained; upgrade rank kept"

msgid "DESC_PIERCE_FIRE"
