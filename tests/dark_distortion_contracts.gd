extends SceneTree
## Structural/geometry contracts only. Real pixel evidence is generated by
## dark_distortion_render_fixture.gd on a real Compatibility renderer.
var checks := 0
var failures := 0
func _initialize() -> void: call_deferred("run")
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		push_error(message)
func run() -> void:
	var arena := RageArena.new()
	arena.practice = true
	arena.sound_enabled = false
	arena.run_seed_override = 72419
	root.add_child(arena)
	arena.process_mode = Node.PROCESS_MODE_DISABLED
	arena.apply_ranks({"dark_enchant": 3, "dark_bow": 3})
	arena.player.position = Vector2(350, 350)
	arena.spawn_enemy("chaser", Vector2(600, 350))
	arena.bow.shoot()
	var arrow := arena.bow.active_gravity_arrow
	var field := arrow.gravity_field
	field._sync_matter_surface()
	check(arena.ground_distortions.get_index() < arena.enemies.get_index(), "Ground distortion layer precedes all actor containers")
	check(arena.ground_distortions.z_index == 0, "Ground distortion layer never sorts behind the arena floor")
	check(field.get_parent() == arrow, "Physics gravity source remains attached to the original arrow tip")
	check(field._distortion_pass.get_parent() == arena.ground_distortions, "Visual pass is in the ground-only layer")
	check(field._background_copy.get_index() < field._matter_surface.get_index(), "Local copy executes immediately before its shader")
	check(field._background_copy.copy_mode == BackBufferCopy.COPY_MODE_RECT, "Copy is explicitly local, not automatic or full viewport")
	var material := field._matter_surface.material as ShaderMaterial
	var unchanged_rng := arena.rng.state
	var unchanged_health: float = arena.enemies.get_child(0).health
	for angle in [0.0, 0.57, PI * 0.5, PI]:
		arrow.rotation = angle
		arrow.position += Vector2(8, 11)
		field._sync_matter_surface()
		check(field._distortion_pass.global_transform.is_equal_approx(field.global_transform), "Copy and shader exactly follow moving/rotated arrow tip")
		var pull: float = material.get_shader_parameter("pull_pixels")
		var swirl: float = material.get_shader_parameter("swirl_pixels")
		var maximum := Vector2(pull, swirl).length()
		for radial_step in range(101):
			var radius := float(radial_step) / 100.0
			var envelope := smoothstep(0.0, 0.12, radius) * (1.0 - smoothstep(0.08, 1.0, radius))
			for ray in range(16):
				var direction := Vector2.from_angle(float(ray) * TAU / 16.0)
				var offset := (direction * pull + direction.orthogonal() * swirl) * envelope
				var source := direction * field.outer_radius * radius + offset
				check(offset.is_finite() and offset.length() <= maximum + 0.0001, "Screen offset is finite and bounded")
				var screen_source: Vector2 = field.get_viewport().get_stretch_transform() * field.get_global_transform_with_canvas() * source
				check(field._background_copy.rect.grow(-1.0).has_point(screen_source), "Every sample plus linear-filter guard lies inside copied rectangle")
	check(arena.rng.state == unchanged_rng, "Visual sync consumes no gameplay RNG")
	check(arena.enemies.get_child(0).health == unchanged_health, "Visual geometry cannot change damage")
	var old_age := field.age
	var old_phase: float = material.get_shader_parameter("phase")
	var old_body_phase: float = material.get_shader_parameter("body_phase")
	await process_frame
	await process_frame
	check(field.age == old_age and material.get_shader_parameter("phase") == old_phase and material.get_shader_parameter("body_phase") == old_body_phase, "Paused simulation freezes refraction, no shader wall clock")
	var previous_canvas := root.canvas_transform
	var previous_copy := field._background_copy.rect
	paused = true
	root.canvas_transform = Transform2D(0.18, Vector2(15, 22))
	await process_frame
	await process_frame
	check(field._background_copy.rect != previous_copy, "Paused camera/canvas change updates copy rectangle without a physics tick")
	check(field.age == old_age and material.get_shader_parameter("phase") == old_phase and material.get_shader_parameter("body_phase") == old_body_phase, "Render-transform maintenance cannot advance the simulation clock")
	check(field.process_mode == Node.PROCESS_MODE_ALWAYS, "Render-transform maintenance remains available during pause")
	root.canvas_transform = previous_canvas
	await process_frame
	await process_frame
	check(field._background_copy.rect == previous_copy, "Restoring the camera restores the exact capture rectangle")
	paused = false
	arrow.hide()
	check(field._background_copy.copy_mode == BackBufferCopy.COPY_MODE_DISABLED and not field._distortion_pass.visible, "Hidden arrow does not keep copying or drawing")
	arrow.show()
	check(field._background_copy.copy_mode == BackBufferCopy.COPY_MODE_RECT and field._distortion_pass.visible, "Showing arrow restores its local pass")
	var second := GravityField.new()
	second.configure(arena.stats, arena.enemies, Callable())
	arena.add_child(second)
	second.position = Vector2(550, 330)
	second._sync_matter_surface()
	check(arena.ground_distortions.get_child_count() == 2, "Each simultaneous field owns an independent copy/surface pair")
	check(second._background_copy.copy_mode == BackBufferCopy.COPY_MODE_RECT, "Second field never relies on first field's captured region")
	var second_pass: WeakRef = weakref(second._distortion_pass)
	second.free()
	check(second_pass.get_ref() == null and arena.ground_distortions.get_child_count() == 1, "Standalone field removal frees ground siblings immediately")
	var pass_ref: WeakRef = weakref(field._distortion_pass)
	arrow.retire(true)
	check(field._background_copy.copy_mode == BackBufferCopy.COPY_MODE_DISABLED, "Retirement immediately disables the copy")
	await process_frame
	check(pass_ref.get_ref() == null and arena.ground_distortions.get_child_count() == 0, "Retired arrow leaves no capture/material orphan")
	arena.bow.gravity_gap_remaining = 0.0
	arena.bow.shoot()
	check(arena.ground_distortions.get_child_count() == 1, "Refire creates exactly one fresh pass")
	var live_refs: Array[WeakRef] = []
	for child in arena.ground_distortions.get_children(): live_refs.append(weakref(child))
	arena.free()
	for reference in live_refs: check(reference.get_ref() == null, "Arena replacement frees every ground pass")
	var source := FileAccess.get_file_as_string("res://scripts/combat/gravity_field.gd")
	var shader := load("res://shaders/dark_field_material.gdshader") as Shader
	check(not source.contains("COPY_MODE_VIEWPORT"), "No whole-screen copy path exists")
	check(shader.code.contains("hint_screen_texture") and shader.code.contains("SCREEN_UV + screen_offset"), "Shader refracts real ground pixels")
	check(not shader.code.contains("TIME"), "Shader has no independent animation clock")
	check(shader.code.contains("radius >= 1.0") and shader.code.contains("smoothstep(0.08, 1.0, radius)"), "Warp is exactly zero beyond the unchanged outer radius")
	print("Dark refraction structural contracts: %d checks, %d failures; not visual certification" % [checks, failures])
	quit(1 if failures else 0)
