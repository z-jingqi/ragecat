extends SceneTree
const JS = preload("res://scripts/core/sf_js.gd")
var failures = 0
func check(condition, message):
 if not condition:
  printerr("FAIL: ",message)
  failures += 1
func _init():
 check(JS.truthy([]) and JS.truthy({}), "empty JS containers are truthy")
 check(not JS.truthy(NAN) and not JS.truthy(0) and not JS.truthy("") and not JS.truthy(null), "falsy values")
 check(JS.roundv(-0.5) == 0 and JS.roundv(-1.5) == -1 and JS.roundv(1.5) == 2, "round toward +Infinity at ties")
 check(JS.u32(-1) == 4294967295 and JS.i32(4294967295) == -1, "32-bit coercion")
 check(JS.imul(0xffffffff, 5) == -5 and JS.imul(0x7fffffff, 0x7fffffff) == 1, "imul low32")
 check(JS.ushr(-1, 1) == 2147483647 and JS.ushr(-1, 33) == 2147483647, "unsigned shifts")
 check(JS.opmod(-5.5, 2) == -1.5, "remainder sign")
 check(JS.parse_int("#ffaa55".replace("#", ""),16) == 16755285, "hex parse")
 check(JS.parse_int(" -12z",10) == -12 and is_nan(JS.parse_int("z",10)), "parse prefix and NAN")
 var arr = [1,2,3]
 check(JS.call_method(arr,"map",[func(v): return v*2]) == [2,4,6], "map arity")
 check(JS.call_method(arr,"filter",[func(v,i): return i%2==0]) == [1,3], "filter arity")
 check(JS.call_method(arr,"splice",[1,1,8,9]) == [2] and arr == [1,8,9,3], "splice mutation")
 check(JS.call_method(arr,"slice",[-2]) == [9,3], "negative slice")
 check(JS.call_method(arr,"unshift",[5,6]) == 6 and arr == [5,6,1,8,9,3], "unshift order")
 check(JS.call_method(arr,"shift",[]) == 5 and JS.call_method(arr,"pop",[]) == 3, "shift pop")
 check(JS.call_method(arr,"fill",[7,1,-1]) == [6,7,7,9], "fill range")
 JS.call_method(arr,"sort",[func(a,b): return b-a])
 check(arr == [9,7,7,6], "sort")
 check(JS.call_method(arr,"entries",[]) == [[0,9],[1,7],[2,7],[3,6]], "entries")
 check(JS.array_from(3,func(_v,i): return i*i) == [0,1,4], "array from")
 check(JS.call_method("##a","replace",["#", ""]) == "#a", "replace first only")
 check(JS.call_method(1.23456,"toFixed",[3]) == "1.235", "toFixed")
 var obj = {"x":1,"f":func(x): return x+3}
 check(JS.getv(obj,"missing") == null and JS.call_method(obj,"f",[5]) == 8, "dictionary optional read and callback")
 check(JS.setv(obj,"x",2) == 2 and obj.x == 2, "assignment expression")
 check(JS.getv([1,2],-1) == null and JS.getv([1,2],"length") == 2, "indexed read bounds")
 var packed = PackedInt64Array([1,2])
 JS.setv(packed,0,9)
 check(packed[0] == 9, "packed mutation through helpers")
 var u8 = JS.typed_array("Uint8Array", [257.9,-1.0,256.0])
 check(u8 == PackedByteArray([1,255,0]), "Uint8 wrap and truncation")
 var f32 = JS.typed_array("Float32Array", [0.1])
 check(f32[0] == 0.10000000149011612, "Float32 rounding")
 var i32arr = JS.typed_array("Int32Array", [4294967295.0])
 check(i32arr[0] == -1, "Int32 typed constructor")
 var u32arr = JS.typed_array("Uint32Array", [-1.0])
 check(u32arr[0] == 4294967295, "Uint32 typed constructor")
 JS.setv(u32arr, 0.5, 2)
 check(u32arr[0] == 4294967295, "fractional typed index ignored")
 print("Sprite Fusion JS native runtime tests: ", "PASS" if failures == 0 else "FAIL", " (", failures, " failures)")
 quit(failures)
